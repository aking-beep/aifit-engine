# API (services/api) — all optional for local development.

# Durable result store for serverless deploys (Upstash or Vercel KV REST).
# Without these, results go to the filesystem under AIFIT_STORE.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AIFIT_STORE=/tmp/aifit-store

# Optional LLM classifier for free-text notes. Off unless set to 1. When on,
# note text is POSTed to AIFIT_LLM_CLASSIFIER_URL (your own adapter, which
# holds any provider keys). AIFIT_LLM_CLASSIFIER_TOKEN is sent as a bearer token.
AIFIT_LLM_CLASSIFIER=
AIFIT_LLM_CLASSIFIER_URL=
AIFIT_LLM_CLASSIFIER_TOKEN=

# Web (apps/web) proxies /v1 and /health to this origin.
API_ORIGIN=http://127.0.0.1:8000
