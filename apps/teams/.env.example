# AI Fit Teams (apps/teams). Every variable is optional: with none set, the app
# runs, and every figure in every report reads `heuristic`.

# --- Calibration: the one call this build makes to ARK Control -------------
# Control origin. Teams sends GET ${ARK_CONTROL_URL}/api/v1/calibration?days=30
# (2.5 s timeout) on every report view and every POST /api/assess. Unset, a
# timeout, a non-200 or a body that does not match the contract all mean
# "no calibration" and the report falls back to the rubric.
# Also used as the "ARK Control" link in the header (default http://localhost:3002),
# so set it to Control's public origin.
ARK_CONTROL_URL=

# Bearer token for an org in Control (an org_tokens row). Control derives the
# org from it; without it Control answers 401 and the report stays heuristic.
# Issue Teams its own read token per org. Never commit a real value.
ARK_CONTROL_TOKEN=

# --- Rate limiting -----------------------------------------------------------
# How many X-Forwarded-For entries were appended by proxies you run. Unset or 1
# takes the right-most entry (correct behind one proxy, such as Vercel's edge).
# Only POST /api/measure rate-limits, so in this build it has no visible effect.
ARK_TRUSTED_PROXY_HOPS=

# --- Measure mode (not available in this build) -----------------------------
# In ark, ARK_MEASURE_ENABLED=1 let POST /api/measure run one synthetic sample
# through ARK Runtime and POST it to ${ARK_CONTROL_URL}/api/v1/events. This
# build carries no Runtime, so measuring stays off whatever this says. Kept so
# a deployment's env can be copied across unchanged; see README.md.
ARK_MEASURE_ENABLED=
# Read only when measuring: the installed Ollama tag for the sample, and the
# Ollama origin a Runtime executor would use.
ARK_OLLAMA_MODEL=
ARK_OLLAMA_URL=

# --- Workspaces (accounts, saved assessments, teams) ---------------------------
# A durable, shared store. Upstash Redis or Vercel KV (same REST protocol).
# On Vercel without these, workspaces are switched off and say so; the
# anonymous assessment keeps working. Locally, a file store under
# AIFIT_TEAMS_STORE (default .data) is used instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL / KV_REST_API_TOKEN are accepted as aliases.
AIFIT_TEAMS_STORE=

# --- Billing (Stripe hosted Checkout) ------------------------------------------
# off (default): everything is free and no checkout is offered.
# test: needs an sk_test_ key. live: needs an sk_live_ key AND BILLING_ALLOW_LIVE=1.
BILLING_MODE=
STRIPE_SECRET_KEY=
# From the Stripe webhook endpoint for https://<host>/api/billing/webhook.
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired,
# customer.subscription.updated, customer.subscription.deleted, invoice.paid,
# invoice.payment_failed, charge.refunded.
STRIPE_WEBHOOK_SECRET=
# Price ids: one-time prices for an assessment and a blueprint, a recurring price for the workspace plan.
STRIPE_PRICE_ASSESSMENT=
STRIPE_PRICE_BLUEPRINT=
STRIPE_PRICE_TEAM_MONTHLY=
BILLING_ALLOW_LIVE=
# Public origin for Stripe's success/cancel redirects. Defaults to https://$VERCEL_URL.
APP_URL=

# --- ARC Control governance export (optional, off) -----------------------------
# The download always works. Set these only if your Control instance implements
# the proposed import endpoint in packages/control-export-contract/CONTRACT.md.
CONTROL_EXPORT_URL=
CONTROL_EXPORT_TOKEN=

# --- AI assistance (optional, off) ---------------------------------------------
# Suggest-only agents: intake suggestions and a plain-language explanation of the
# decision. Both are checked by code and change nothing without the person.
# Requires AIFIT_AGENTS=1 AND an Anthropic API key; otherwise nothing is called.
AIFIT_AGENTS=
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5.
AIFIT_AGENT_MODEL=
# Model calls per UTC day per server instance (default 500).
AIFIT_AGENT_DAILY_CAP=

# --- Marketing, leads and email (all optional; each feature is off when unset) ---
# ARC Transformation Group links (defaults: the ARC site and its Calendly booking page)
# NEXT_PUBLIC_ARC_SITE_URL=https://arc-website-pi-five.vercel.app
# NEXT_PUBLIC_ARC_BOOKING_URL=https://calendly.com/aking-arctransformationgroup/30min
# Public origin for canonical links, the sitemap and share images
# NEXT_PUBLIC_SITE_URL=https://ark-ai-fit-teams.vercel.app
# Leads: forwarded to a CRM/automation as a webhook signed `t=<unix>,v1=<HMAC-SHA256(secret, "t.body")>`
# LEAD_WEBHOOK_URL=https://hooks.zapier.com/...
# LEAD_WEBHOOK_SECRET=
# LEAD_NOTIFY_EMAIL=you@arctransformationgroup.com
# Operator export: GET /api/leads (?format=csv) with `Authorization: Bearer <token>` (24+ chars)
# LEADS_EXPORT_TOKEN=
# Email (password reset, invites, receipts, lead notices) via Resend
# RESEND_API_KEY=
# EMAIL_FROM="AI Fit Teams <hello@your-domain>"
# EMAIL_REPLY_TO=
# Ad pixels: loaded only after the visitor accepts the cookie banner
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_GTAG_ID=G-XXXXXXX or AW-XXXXXXX
# NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
# Vercel Web Analytics: enable it in the project's Analytics tab (no variable needed).
