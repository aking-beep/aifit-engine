{
  "name": "@aifit/teams",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "npm run build:packages --prefix ../.. && next dev -p 3001",
    "build": "npm run build:packages --prefix ../.. && next build",
    "start": "next start -p 3001",
    "typecheck": "npm run build:packages --prefix ../.. && tsc -p tsconfig.json --noEmit",
    "test": "npm run build:packages --prefix ../.. && node --experimental-strip-types --test src/lib/measure.test.ts src/lib/intake-verdict.test.ts src/lib/intake-state.test.ts src/lib/intake-suggestions.test.ts src/lib/marketing.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aifit/agents": "*",
    "@aifit/control-export-contract": "*",
    "@aifit/decision-core": "*",
    "@aifit/deliverables": "*",
    "@aifit/platform": "*",
    "@aifit/teams-core": "*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.43.0",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.9.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0"
  }
}
