NEXT_PUBLIC_API_BASE_URL=
# Used by `next dev` to proxy /v1 to the local API. Leave unset on Vercel.
API_ORIGIN=http://127.0.0.1:8472

# Optional launch gate. Default off — do not paywall the quiz.
# off | waitlist | code
FIT_ACCESS_GATE=off
NEXT_PUBLIC_FIT_ACCESS_GATE=off
# Comma-separated, case-insensitive. Required when FIT_ACCESS_GATE=code.
FIT_ACCESS_CODES=
# Shown on the waitlist / code screen.
FIT_WAITLIST_NOTE=
# JSONL path for waitlist emails. Default /tmp/aifit-waitlist.jsonl
FIT_WAITLIST_PATH=
