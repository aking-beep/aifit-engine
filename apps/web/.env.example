NEXT_PUBLIC_API_BASE_URL=
# Used by `next dev` to proxy /v1 to the local API. Leave unset on Vercel.
API_ORIGIN=http://127.0.0.1:8472

# The Consumer API (services/api) reads these on Vercel; see the root .env.example.
# Accounts need a durable store: UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN
# (or KV_REST_API_URL / KV_REST_API_TOKEN). Without them /v1/account/* answers 503.
# Pro billing: BILLING_MODE=test, STRIPE_SECRET_KEY=sk_test_..., STRIPE_WEBHOOK_SECRET=whsec_...,
# STRIPE_PRICE_PRO=price_..., APP_URL=https://<deployment>. Webhook URL: <APP_URL>/v1/billing/webhook
# with checkout.session.*, customer.subscription.updated/deleted, invoice.paid/payment_failed, charge.refunded.
