{
  "name": "@aifit/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Specialised Claude agents for AI Fit and their harness. Agents explain, suggest and verify; they never set an outcome, a hard constraint, an entitlement or a price. Every output is schema-validated and then checked deterministically (quoted evidence must appear in the source).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "prompts", "fixtures", "evals"],
  "scripts": {
    "build": "node scripts/generate.mjs && tsc -p tsconfig.json",
    "typecheck": "node scripts/generate.mjs && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/*.test.js",
    "eval": "npm run build && node dist/eval-cli.js",
    "verify-catalog": "npm run build && node dist/verify-catalog-cli.js"
  },
  "dependencies": {
    "@aifit/decision-core": "*",
    "@aifit/teams-core": "*",
    "@anthropic-ai/sdk": "^1.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": { "typescript": "^5.6.0", "@types/node": "^22.9.0" }
}
