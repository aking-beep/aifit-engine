{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aking-beep/aifit-engine/packages/control-export-contract/governance-export.schema.json",
  "title": "AI Fit Teams → ARC Control GovernanceExport v1 (proposed)",
  "description": "Recommendations derived from one AI Fit Teams assessment. Nothing in this document is an enforced control. Mirrors src/index.ts; contract.test.ts checks the two agree on required keys and literals.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "enforcement", "disclaimer", "source", "workload", "governanceRequirements", "policySuggestions", "agentInventory", "evaluationEvidence"],
  "properties": {
    "contract": { "const": "aifit.control-export" },
    "version": { "const": "1.0.0" },
    "enforcement": { "const": "recommended-not-enforced" },
    "disclaimer": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "generatedAt", "assessment", "inputHash", "engines"],
      "properties": {
        "product": { "const": "AI Fit Teams" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "assessment": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "rootId", "version"],
              "properties": {
                "id": { "type": "string", "maxLength": 60 },
                "rootId": { "type": "string", "maxLength": 60 },
                "version": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "inputHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "engines": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 80 } }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "verdict", "outcome", "pattern", "dataClasses", "regulated", "riskLevel"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "verdict": { "enum": ["not-ai", "not-yet", "assisted", "automate-bounded", "automate"] },
        "outcome": { "enum": ["no_change", "conventional_software", "conventional_automation", "buy_ai", "build_ai"] },
        "pattern": { "type": "string", "minLength": 1, "maxLength": 60 },
        "dataClasses": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 40 } },
        "regulated": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 40 } },
        "riskLevel": { "enum": ["low", "moderate", "high", "severe"] }
      }
    },
    "governanceRequirements": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirement", "rationale", "severity", "source", "verification"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{1,80}$" },
          "requirement": { "type": "string", "minLength": 1, "maxLength": 600 },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 800 },
          "severity": { "enum": ["blocking", "recommended"] },
          "source": { "enum": ["security-rubric", "decision-rules", "evaluation-plan"] },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "owner"],
            "properties": {
              "method": { "type": "string", "minLength": 1, "maxLength": 400 },
              "owner": { "const": "customer" }
            }
          }
        }
      }
    },
    "policySuggestions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "rule", "rationale", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{1,80}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 800 },
          "status": { "const": "suggested" },
          "rule": {
            "oneOf": [
              { "type": "object", "additionalProperties": false, "required": ["kind", "actions"], "properties": { "kind": { "const": "require_human_approval" }, "actions": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string" } } } },
              { "type": "object", "additionalProperties": false, "required": ["kind", "dataClasses"], "properties": { "kind": { "const": "redact_data_classes" }, "dataClasses": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string" } } } },
              { "type": "object", "additionalProperties": false, "required": ["kind", "dataClasses"], "properties": { "kind": { "const": "deny_data_classes" }, "dataClasses": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string" } } } },
              { "type": "object", "additionalProperties": false, "required": ["kind", "usd", "basis"], "properties": { "kind": { "const": "monthly_spend_cap" }, "usd": { "type": "number", "exclusiveMinimum": 0 }, "basis": { "enum": ["heuristic", "benchmark", "calibrated", "measured"] } } },
              { "type": "object", "additionalProperties": false, "required": ["kind", "maxTurnsPerOutcome"], "properties": { "kind": { "const": "turn_cap" }, "maxTurnsPerOutcome": { "type": "integer", "minimum": 1, "maximum": 1000 } } },
              { "type": "object", "additionalProperties": false, "required": ["kind", "region"], "properties": { "kind": { "const": "data_residency" }, "region": { "enum": ["us", "eu", "on_prem"] } } },
              { "type": "object", "additionalProperties": false, "required": ["kind", "tools"], "properties": { "kind": { "const": "tool_allow_list" }, "tools": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string" } } } }
            ]
          }
        }
      }
    },
    "agentInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reason", "entries"],
      "properties": {
        "required": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 400 },
        "entries": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "pattern", "autonomy", "modelId", "dataClasses", "tools", "owner"],
            "properties": {
              "name": { "type": "string" },
              "pattern": { "type": "string" },
              "autonomy": { "enum": ["suggest", "approve", "bounded", "full"] },
              "modelId": { "type": ["string", "null"] },
              "dataClasses": { "type": "array", "items": { "type": "string" } },
              "owner": { "type": "null" },
              "tools": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "system", "write", "blastRadius", "approvalRequired"],
                  "properties": {
                    "name": { "type": "string" },
                    "system": { "type": "string" },
                    "write": { "type": "boolean" },
                    "blastRadius": { "enum": ["none", "reversible", "costly", "irreversible"] },
                    "approvalRequired": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "evaluationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "kind", "goldenSetSize", "acceptanceCriteria", "observed", "note"],
      "properties": {
        "status": { "enum": ["planned", "not-applicable"] },
        "kind": { "enum": ["golden-set", "deterministic"] },
        "goldenSetSize": { "type": ["integer", "null"], "minimum": 1 },
        "acceptanceCriteria": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "threshold", "measuredHow", "blocksLaunch"],
            "properties": {
              "name": { "type": "string" },
              "threshold": { "type": "string" },
              "measuredHow": { "type": "string" },
              "blocksLaunch": { "type": "boolean" }
            }
          }
        },
        "observed": { "type": "array", "maxItems": 0 },
        "note": { "type": "string", "minLength": 1, "maxLength": 600 }
      }
    }
  }
}
